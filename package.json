{
  "name": "political-correct-fighters",
  "private": true,
  "version": "0.1.0",
  "description": "Digitales 1-gegen-1-Kartenduell: Humans vs. Animals",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "server": "npm run dev --workspace @pcf/server",
    "client": "npm run dev --workspace @pcf/client",
    "build": "npm run build --workspace @pcf/client",
    "start": "npm run start --workspace @pcf/server",
    "test": "npm run test --workspace @pcf/engine && npm run test --workspace @pcf/server && npm run test --workspace @pcf/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "audit:identities": "node scripts/audit-card-coherence.mjs --check",
    "sync:identities": "node scripts/sync-identity-catalog.mjs --write",
    "check:art": "node scripts/render-card-art.mjs --check",
    "render:standard-art": "node scripts/render-card-art.mjs --standard-set",
    "generate:standard-figures": "node scripts/generate-standard-deck-figures.mjs --write --include-insect",
    "list-missing-art": "node scripts/list-missing-art.mjs",
    "backtest": "tsx scripts/backtest/backtest.ts",
    "balance": "tsx scripts/balancing/run.ts",
    "balance:technical": "tsx scripts/balancing/run.ts --mode=technical",
    "balance:full": "tsx scripts/balancing/run.ts --mode=full --no-mirrors",
    "balance:pc": "tsx scripts/balancing/run.ts --mode=pc --no-mirrors",
    "balance:replay": "tsx scripts/balancing/replay.ts"
  }
}
